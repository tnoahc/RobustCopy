<Window x:Class="RoboCopyGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RoboCopy GUI"
        Width="1280"
        Height="680"
        MinWidth="1200"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="104" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Command bar: brand at left, safety guidance/status above actions at right. -->
        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="0"
                Margin="20,14,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="43*" />
                    <ColumnDefinition Width="50*" />
                    <ColumnDefinition Width="7*" MinWidth="92" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="2"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42"
                                Height="42"
                                CornerRadius="11"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center"
                                Effect="{StaticResource AccentGlowEffect}">
                            <TextBlock Text="&#x21C4;"
                                       FontFamily="Segoe UI Symbol, Segoe UI"
                                       Foreground="White"
                                       FontSize="22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ROBOCOPY" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="Reliable Windows file transfers, without command-line guesswork"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Margin="9,4" VerticalAlignment="Center">
                        <TextBlock Text="Review the command before using Mirror, Purge, or Move."
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Stop ends the current run; Pause keeps Robocopy in memory for Resume."
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,0,1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Stage}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="START"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartCommand}"
                            Margin="5,4,2.5,5" />
                    <Button Grid.Column="1"
                            Content="PAUSE"
                            Command="{Binding PauseCommand}"
                            Margin="2.5,4,2.5,5" />
                    <Button Grid.Column="2"
                            Content="RESUME"
                            Command="{Binding ResumeCommand}"
                            Margin="2.5,4,2.5,5" />
                    <Button Grid.Column="3"
                            Content="STOP"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding StopCommand}"
                            Margin="2.5,4,5,5" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,16,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.92*" MinWidth="340" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.02*" MinWidth="380" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.06*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Location and copy-option columns share this grid so their rows stay aligned. -->
            <Grid Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.92*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1.02*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="10,7,10,6">
                            <TextBlock Text="TRANSFER LOCATIONS" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="Choose what to copy and where it should go"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="0,1,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="7,0,7,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SOURCE"
                                           Style="{StaticResource EyebrowTextStyle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                             Height="34"
                                             IsReadOnly="{Binding IsBusy}"
                                             AutomationProperties.Name="Source folder" />
                                    <Button Grid.Column="1"
                                            Content="&#x2026;"
                                            Width="32"
                                            Height="34"
                                            Padding="0"
                                            Margin="5,0,0,0"
                                            ToolTip="Browse for source folder"
                                            Command="{Binding BrowseSourceCommand}" />
                                </Grid>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding SwapCommand}"
                                    Margin="7,17"
                                    Padding="3,2">
                                <TextBlock Text="&#x21C5;  Swap&#x0a;locations"
                                           TextAlignment="Center"
                                           FontWeight="SemiBold" />
                            </Button>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="DESTINATION"
                                           Style="{StaticResource EyebrowTextStyle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                             Height="34"
                                             IsReadOnly="{Binding IsBusy}"
                                             AutomationProperties.Name="Destination folder" />
                                    <Button Grid.Column="1"
                                            Content="&#x2026;"
                                            Width="32"
                                            Height="34"
                                            Padding="0"
                                            Margin="5,0,0,0"
                                            ToolTip="Browse for destination folder"
                                            Command="{Binding BrowseDestinationCommand}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="3" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="18,12,18,7">
                            <TextBlock Text="Choose a transfer strategy"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0" />
                            <TextBlock Text="Click an option card to include its Robocopy switch. Conflicts are disabled automatically."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding OptionsView}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AccentSoftBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    CornerRadius="8"
                                                    Padding="5.5,3.5"
                                                    Margin="14,8,14,4">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="14,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>

                                        <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsAvailable}"
                                                      Style="{StaticResource OptionToggleStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="20" Height="20" CornerRadius="5" VerticalAlignment="Top">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="&#x2713;"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               FontSize="13"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                        <Border Background="{DynamicResource SurfaceAlternativeBrush}"
                                                                CornerRadius="6"
                                                                Padding="3,1"
                                                                Margin="8,-1,0,0">
                                                            <TextBlock Text="{Binding Flag}"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       FontFamily="Cascadia Mono, Consolas"
                                                                       FontSize="10.5"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DisplayDescription}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </ToggleButton>

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsSelected}"
                                                 Visibility="{Binding HasValue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 Padding="4,3"
                                                 Margin="10,0,0,0"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="2" Margin="18,7,18,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ADVANCED OPTIONS"
                                       Style="{StaticResource EyebrowTextStyle}"
                                       VerticalAlignment="Center" />
                            <TextBox Text="{Binding AdvancedOptions, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Column="1"
                                     Height="34"
                                     Margin="12,0,0,0"
                                     IsReadOnly="{Binding IsBusy}"
                                     ToolTip="Self-contained Robocopy switches only, for example /FFT /COMPRESS" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="10,7,10,6">
                            <TextBlock Text="REVIEW COMMAND BEFORE RUNNING"
                                       Style="{StaticResource EyebrowTextStyle}"
                                       VerticalAlignment="Center" />
                            <Button Content="Copy"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Padding="5,2.5"
                                    Command="{Binding CopyCommandCommand}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="8,0,8,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FILE PATTERNS"
                                       Style="{StaticResource EyebrowTextStyle}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding FilePatterns, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32"
                                     Margin="8,0,0,0"
                                     ToolTip="Examples: *.*   *.jpg   &quot;annual report*.pdf&quot;"
                                     IsReadOnly="{Binding IsBusy}" />
                        </Grid>

                        <TextBox Grid.Row="2"
                                 Text="{Binding CommandPreview, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0,1"
                                 Margin="0" />

                        <Border Grid.Row="3"
                                Background="{DynamicResource DangerSoftBrush}"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4,2.5"
                                Margin="8,7,8,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ValidationText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ValidationText}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="11.5" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Progress and output column -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="7">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Live transfer overview"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Margin="0,0,0,0" />
                                <TextBlock Text="{Binding StatusText}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="12"
                                    Padding="5,2.5"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding OverallPercentText}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,10,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding OverallLabel}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding TransferredText}" Style="{StaticResource MutedTextStyle}" />
                        </Grid>
                        <ProgressBar Value="{Binding OverallPercent, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsScanning}" />

                        <Grid Margin="0,8,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Current file" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrentFilePercentText}" Style="{StaticResource MutedTextStyle}" />
                        </Grid>
                        <TextBlock Text="{Binding CurrentFile}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CurrentFile}"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,0,0,4" />
                        <ProgressBar Value="{Binding CurrentFilePercent, Mode=OneWay}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource MetricCardStyle}" Padding="4.5,3">
                                <StackPanel>
                                    <TextBlock Text="SPEED" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Text="{Binding SpeedText}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Padding="4.5,3">
                                <StackPanel>
                                    <TextBlock Text="TIME LEFT" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Text="{Binding EtaText}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}" Padding="4.5,3">
                                <StackPanel>
                                    <TextBlock Text="FILES" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Text="{Binding FilesText}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="16,11,16,9">
                            <StackPanel>
                                <TextBlock Text="Run transcript" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Saved automatically in local app data."
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Content="Copy"
                                        Padding="5,2.5"
                                        Command="{Binding CopyLogCommand}" />
                                <Button Content="Open"
                                        Padding="5,2.5"
                                        Margin="7,0,0,0"
                                        Command="{Binding OpenLogCommand}" />
                                <Button Content="Folder"
                                        Padding="5,2.5"
                                        Margin="7,0,0,0"
                                        Command="{Binding OpenLogsFolderCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{DynamicResource SurfaceAlternativeBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1"
                                Padding="1">
                            <TextBox Text="{Binding LogText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="11"
                                     BorderThickness="0"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Padding="6,4.5" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</Window>
