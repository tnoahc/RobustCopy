<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RobustCopy</AssemblyName>
    <Product>RobustCopy</Product>
    <AssemblyTitle>RobustCopy</AssemblyTitle>
    <Version>1.0.0</Version>
    <Company>Kaleb Creative Studio</Company>
    <Authors>Kaleb Creative Studio</Authors>
    <Description>A focused Windows desktop interface for reliable Robocopy file transfers.</Description>
    <RepositoryUrl>https://gitlab.tarinyebwa.com/tnoahc/robustcopy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Copyright>Copyright © 2026 Kaleb Creative Studio</Copyright>
    <RootNamespace>RobustCopy</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\RobustCopy.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishSelfContained>true</PublishSelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\RobustCopy.ico" />
  </ItemGroup>

</Project>
