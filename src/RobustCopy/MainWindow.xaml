<Window x:Class="RobustCopy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:core="clr-namespace:RobustCopy.Core"
        mc:Ignorable="d"
        Title="RobustCopy"
        Width="1200"
        Height="680"
        MinWidth="1000"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Background="#14171A">
    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#14171A" />
        <SolidColorBrush x:Key="BgRaisedBrush" Color="#191D21" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1C2125" />
        <SolidColorBrush x:Key="Panel2Brush" Color="#21262B" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#2B3238" />
        <SolidColorBrush x:Key="BorderSoftBrush" Color="#23292E" />
        <SolidColorBrush x:Key="TextLightBrush" Color="#E8EBED" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#9AA3AB" />
        <SolidColorBrush x:Key="TextFaintBrush" Color="#5B6469" />
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#35D6A8" />
        <SolidColorBrush x:Key="AccentGreenDimBrush" Color="#1E8F6F" />
        <SolidColorBrush x:Key="AmberBrush" Color="#F0B437" />
        <SolidColorBrush x:Key="AmberDimBrush" Color="#8A6A22" />
        <SolidColorBrush x:Key="RedBrush" Color="#EA5257" />
        <SolidColorBrush x:Key="RedDimBrush" Color="#7A3234" />
        <SolidColorBrush x:Key="BlueBrush" Color="#5B9CE0" />
        <SolidColorBrush x:Key="ConsoleBrush" Color="#0F1214" />

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Space Grotesk, Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextLightBrush}" />
        </Style>

        <Style x:Key="PanelSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MonoLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
        </Style>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentGreenDimBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Space Grotesk, Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextLightBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentGreenBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentGreenDimBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource AccentGreenDimBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PathButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextLightBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="OptionCardStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource TextLightBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentGreenDimBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#1B3430" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentGreenBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConsoleProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
            <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkVerticalScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  IsTabStop="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource BorderBrushDark}"
                                                        CornerRadius="4"
                                                        Margin="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  IsTabStop="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="OptionCardTemplate">
            <Grid Height="98" Margin="4">
                <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsAvailable}"
                              Style="{StaticResource OptionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="18" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding FlagText}"
                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                   FontSize="10.5"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border HorizontalAlignment="Right"
                                Width="14"
                                Height="14"
                                BorderThickness="1"
                                CornerRadius="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="&#x2713;"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#0B1F1A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Label}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" />
                        <TextBlock Grid.Row="2"
                                   Text="{Binding DisplayDescription}"
                                   FontSize="10.5"
                                   LineHeight="14"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </ToggleButton>

                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding HasValue, Converter={StaticResource BooleanToVisibilityConverter}}"
                         IsEnabled="{Binding IsSelected}"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Width="48"
                         Height="23"
                         Padding="4,2"
                         Margin="0,6,24,0"
                         FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                         FontSize="9.5"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Rectangle IsHitTestVisible="False" Opacity="0.65">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="#0BFFFFFF" Geometry="M 0,0 L 3,0 3,1 0,1 Z" />
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Border Width="620"
                Height="340"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.12,0.05" GradientOrigin="0.12,0.05" RadiusX="0.8" RadiusY="1">
                    <GradientStop Color="#1435D6A8" Offset="0" />
                    <GradientStop Color="#0014171A" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="136" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="520" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="WINDOWS FILE TRANSFER UTILITY"
                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentGreenBrush}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#8035D6A8" BlurRadius="7" ShadowDepth="0" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="ROBUSTCOPY"
                                   FontFamily="Space Grotesk, Segoe UI Variable Display, Segoe UI"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#F4F6F7"
                                   Margin="0,5,0,0" />
                        <TextBlock Text="Reliable Windows file transfers, without command-line guesswork"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="42" />
                        </Grid.RowDefinitions>

                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="Review the command before using Mirror, Purge, or Move."
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AmberBrush}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="Stop ends the current run. Pause keeps Robocopy in memory for Resume."
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       Margin="0,2,0,0"
                                       HorizontalAlignment="Right" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{StaticResource PanelBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="12,5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Stage}" Value="{x:Static core:CopyJobStage.Scanning}">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenDimBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Stage}" Value="{x:Static core:CopyJobStage.Running}">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenDimBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Stage}" Value="{x:Static core:CopyJobStage.Paused}">
                                            <Setter Property="BorderBrush" Value="{StaticResource AmberDimBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Stage}" Value="{x:Static core:CopyJobStage.Failed}">
                                            <Setter Property="BorderBrush" Value="{StaticResource RedDimBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Stage}" Value="{x:Static core:CopyJobStage.Canceled}">
                                            <Setter Property="BorderBrush" Value="{StaticResource RedDimBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextFaintBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Stage}" Value="{x:Static core:CopyJobStage.Scanning}">
                                                    <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Stage}" Value="{x:Static core:CopyJobStage.Running}">
                                                    <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Stage}" Value="{x:Static core:CopyJobStage.Paused}">
                                                    <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Stage}" Value="{x:Static core:CopyJobStage.Failed}">
                                                    <Setter Property="Fill" Value="{StaticResource RedBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Stage}" Value="{x:Static core:CopyJobStage.Canceled}">
                                                    <Setter Property="Fill" Value="{StaticResource RedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StageText}"
                                           FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextDimBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Width="460"
                                HorizontalAlignment="Right"
                                Background="{StaticResource BorderBrushDark}"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                CornerRadius="3"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="START"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="{StaticResource AccentGreenBrush}"
                                        Foreground="#0B1F1A"
                                        Margin="0,0,1,0"
                                        Command="{Binding StartCommand}" />
                                <Button Grid.Column="1"
                                        Content="PAUSE"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="{StaticResource AmberBrush}"
                                        Foreground="#241A03"
                                        Margin="0,0,1,0"
                                        Command="{Binding PauseCommand}" />
                                <Button Grid.Column="2"
                                        Content="RESUME"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="{StaticResource Panel2Brush}"
                                        Foreground="{StaticResource TextLightBrush}"
                                        BorderBrush="{StaticResource BlueBrush}"
                                        BorderThickness="0,2,0,0"
                                        Margin="0,0,1,0"
                                        Command="{Binding ResumeCommand}" />
                                <Button Grid.Column="3"
                                        Content="STOP"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="{StaticResource RedBrush}"
                                        Foreground="#2B0C0D"
                                        Command="{Binding StopCommand}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Three-column workspace -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Transfer locations -->
                <Border Grid.Column="0"
                        Height="464"
                        VerticalAlignment="Top"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushDark}"
                        BorderThickness="1"
                        CornerRadius="3"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="82" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="18,14">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="TRANSFER LOCATIONS" Style="{StaticResource PanelTitleStyle}" />
                                    <TextBlock Text="Choose what to copy and where it should go"
                                               Style="{StaticResource PanelSubtitleStyle}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Content="Clear"
                                        Style="{StaticResource FlatButtonStyle}"
                                        FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                        FontSize="10"
                                        Padding="8,3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Command="{Binding ClearPathsCommand}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="18,14,18,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="13" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="25" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="SOURCE" Style="{StaticResource MonoLabelStyle}" />
                            <Button Grid.Row="1"
                                    Style="{StaticResource PathButtonStyle}"
                                    Command="{Binding BrowseSourceCommand}"
                                    ToolTip="Choose source folder"
                                    AutomationProperties.Name="Choose source folder">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource TextDimBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SourcePathDisplay}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>

                            <Button Grid.Row="2"
                                    Width="26"
                                    Height="26"
                                    Style="{StaticResource FlatButtonStyle}"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    Content="&#x21C5;"
                                    FontSize="13"
                                    Command="{Binding SwapCommand}"
                                    ToolTip="Swap source and destination"
                                    AutomationProperties.Name="Swap source and destination" />

                            <TextBlock Grid.Row="3" Text="DESTINATION" Style="{StaticResource MonoLabelStyle}" />
                            <Button Grid.Row="4"
                                    Style="{StaticResource PathButtonStyle}"
                                    Command="{Binding BrowseDestinationCommand}"
                                    ToolTip="Choose destination folder"
                                    AutomationProperties.Name="Choose destination folder">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource TextDimBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DestinationPathDisplay}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>

                            <TextBlock Grid.Row="6" Text="FILES" Style="{StaticResource MonoLabelStyle}" />
                            <Grid Grid.Row="7">
                                <TextBox Text="{Binding FilePatterns, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Padding="29,7,10,7"
                                         FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                         FontSize="11.5"
                                         IsReadOnly="{Binding IsBusy}" />
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="Segoe Fluent Icons"
                                           Foreground="{StaticResource TextDimBrush}"
                                           Margin="11,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>

                            <Border Grid.Row="8" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" />

                            <Grid Grid.Row="9">
                                <TextBlock Text="Review command before running"
                                           FontFamily="Space Grotesk, Segoe UI Variable Display, Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}"
                                           VerticalAlignment="Center" />
                                <Button Content="copy"
                                        Style="{StaticResource FlatButtonStyle}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                        FontSize="10"
                                        Padding="3"
                                        HorizontalAlignment="Right"
                                        Command="{Binding CopyCommandCommand}" />
                            </Grid>

                            <Border Grid.Row="10"
                                    Background="{StaticResource ConsoleBrush}"
                                    BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="12,9">
                                <TextBlock Text="{Binding CommandPreview, Mode=OneWay}"
                                           FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                           FontSize="11"
                                           LineHeight="19"
                                           Foreground="{StaticResource AccentGreenBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Border Grid.Row="11"
                                    Background="#247A3234"
                                    BorderBrush="{StaticResource RedDimBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="7,4"
                                    Margin="0,7,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ValidationText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ValidationText}"
                                           Foreground="{StaticResource RedBrush}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Transfer strategy -->
                <Border Grid.Column="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushDark}"
                        BorderThickness="1"
                        CornerRadius="3"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="82" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="58" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="CHOOSE A TRANSFER STRATEGY" Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock Text="Click an option card to include its switch. Conflicts are disabled automatically."
                                           Style="{StaticResource PanelSubtitleStyle}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      Padding="14,2,14,10"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkVerticalScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <StackPanel>
                                <TextBlock Text="FOLDERS" Style="{StaticResource MonoLabelStyle}" Margin="4,14,4,5" />
                                <ItemsControl ItemsSource="{Binding FolderOptions}" ItemTemplate="{StaticResource OptionCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <TextBlock Text="RELIABILITY" Style="{StaticResource MonoLabelStyle}" Margin="4,14,4,5" />
                                <ItemsControl ItemsSource="{Binding ReliabilityOptions}" ItemTemplate="{StaticResource OptionCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <TextBlock Text="METADATA" Style="{StaticResource MonoLabelStyle}" Margin="4,14,4,5" />
                                <ItemsControl ItemsSource="{Binding MetadataOptions}" ItemTemplate="{StaticResource OptionCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <TextBlock Text="FILTERS" Style="{StaticResource MonoLabelStyle}" Margin="4,14,4,5" />
                                <ItemsControl ItemsSource="{Binding FilterOptions}" ItemTemplate="{StaticResource OptionCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <TextBlock Text="PERFORMANCE" Style="{StaticResource MonoLabelStyle}" Margin="4,14,4,5" />
                                <ItemsControl ItemsSource="{Binding PerformanceOptions}" ItemTemplate="{StaticResource OptionCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <TextBlock Text="DESTRUCTIVE OPERATIONS" Style="{StaticResource MonoLabelStyle}" Margin="4,14,4,5" />
                                <ItemsControl ItemsSource="{Binding DestructiveOptions}" ItemTemplate="{StaticResource OptionCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="14,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ADVANCED"
                                           Style="{StaticResource MonoLabelStyle}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding AdvancedOptions, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Height="36"
                                         Padding="8,5"
                                         Margin="12,0,0,0"
                                         FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                         FontSize="10.5"
                                         IsReadOnly="{Binding IsBusy}"
                                         ToolTip="Self-contained Robocopy switches only, for example /FFT /COMPRESS" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Live transfer overview -->
                <Border Grid.Column="4"
                        Height="452"
                        VerticalAlignment="Top"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushDark}"
                        BorderThickness="1"
                        CornerRadius="3"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="82" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="LIVE TRANSFER OVERVIEW" Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock Text="{Binding StatusText}"
                                           Style="{StaticResource PanelSubtitleStyle}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="18,16,18,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="19" />
                                <RowDefinition Height="23" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="38" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="62" />
                                <RowDefinition Height="39" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <TextBlock Text="{Binding OverallLabel}"
                                           FontFamily="Space Grotesk, Segoe UI Variable Display, Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" />
                                <TextBlock Text="{Binding OverallPercentText}"
                                           HorizontalAlignment="Right"
                                           FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                           FontSize="15"
                                           Foreground="{StaticResource AccentGreenBrush}" />
                            </Grid>
                            <ProgressBar Grid.Row="1"
                                         Value="{Binding OverallPercent, Mode=OneWay}"
                                         IsIndeterminate="{Binding IsScanning}"
                                         Style="{StaticResource ConsoleProgressStyle}" />

                            <TextBlock Grid.Row="2" Text="CURRENT FILE" Style="{StaticResource MonoLabelStyle}" VerticalAlignment="Bottom" />
                            <Grid Grid.Row="3" Grid.RowSpan="2">
                                <TextBox Text="{Binding CurrentFile, Mode=OneWay}"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         IsReadOnly="True"
                                         Padding="10,7"
                                         FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                         FontSize="11" />
                                <TextBlock Text="{Binding CurrentFilePercentText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                           FontSize="9.5"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           IsHitTestVisible="False" />
                            </Grid>

                            <Grid Grid.Row="6" Background="{StaticResource BorderBrushDark}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource Panel2Brush}" Padding="11,8">
                                    <StackPanel>
                                        <TextBlock Text="SPEED" Style="{StaticResource MonoLabelStyle}" FontSize="9.5" />
                                        <TextBlock Text="{Binding SpeedText}"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                   FontSize="14"
                                                   Foreground="{StaticResource AccentGreenBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource Panel2Brush}" Padding="11,8">
                                    <StackPanel>
                                        <TextBlock Text="TIME LEFT" Style="{StaticResource MonoLabelStyle}" FontSize="9.5" />
                                        <TextBlock Text="{Binding EtaText}"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                   FontSize="14"
                                                   Foreground="{StaticResource BlueBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Background="{StaticResource Panel2Brush}" Padding="11,8">
                                    <StackPanel>
                                        <TextBlock Text="FILES" Style="{StaticResource MonoLabelStyle}" FontSize="9.5" />
                                        <TextBlock Text="{Binding FilesText}"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextLightBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="7">
                                <TextBlock Text="Run transcript"
                                           FontFamily="Space Grotesk, Segoe UI Variable Display, Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="saved to %localappdata%"
                                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                               FontSize="9"
                                               Foreground="{StaticResource TextFaintBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <Button Content="COPY" Style="{StaticResource FlatButtonStyle}" FontSize="8.5" Padding="3,2" Command="{Binding CopyLogCommand}" />
                                    <Button Content="OPEN" Style="{StaticResource FlatButtonStyle}" FontSize="8.5" Padding="3,2" Margin="3,0,0,0" Command="{Binding OpenLogCommand}" />
                                    <Button Content="DIR" Style="{StaticResource FlatButtonStyle}" FontSize="8.5" Padding="3,2" Margin="3,0,0,0" Command="{Binding OpenLogsFolderCommand}" />
                                </StackPanel>
                            </Grid>

                            <TextBox Grid.Row="8"
                                     Text="{Binding LogText, Mode=OneWay}"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     Background="{StaticResource ConsoleBrush}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                     FontSize="10.5"
                                     Foreground="{StaticResource TextDimBrush}"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Padding="12,9" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
